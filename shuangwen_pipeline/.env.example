# ---- 模型 API Key（LiteLLM 标准环境变量）----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ---- 模型路由覆盖（可选，默认值见 src/shuangwen/config.py）----
# SW_MODEL_ARCHITECT=anthropic/claude-opus-4-6
# SW_MODEL_WRITER=gemini/gemini-2.5-pro
# SW_MODEL_BANTER=openai/gpt-4o-2024-11-20
# SW_MODEL_INTIMATE=xai/grok-3-latest
# SW_MODEL_LIGHT=gemini/gemini-2.5-flash

# ---- 状态持久化（三选一：Postgres > SQLite > 内存）----
# SW_POSTGRES_DSN=postgresql://user:pass@localhost:5432/shuangwen
# SW_SQLITE_PATH=./data/checkpoints.sqlite
# SW_REDIS_URL=redis://localhost:6379/0

# ---- 运行参数 ----
# SW_OUTPUT_DIR=./output
# SW_GEMINI_CONTEXT_CACHE=1
# SW_CACHE_TTL_SECONDS=7200
# SW_MOCK_LLM=0
